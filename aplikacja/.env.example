DJANGO_SECRET_KEY=zmien-mnie
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Na serwerze sklepu za Nginx z HTTPS ustaw 1: ciasteczka Secure, nagłówek HSTS, przekierowanie na HTTPS.
DJANGO_HTTPS=0

MYSQL_ROOT_PASSWORD=zmien-mnie
MYSQL_DATABASE=warzywniak
MYSQL_USER=warzywniak
MYSQL_PASSWORD=zmien-mnie

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Klucz tajny testowego środowiska Stripe (sk_test_...). Pusty: symulowana rejestracja karty.
STRIPE_SECRET_KEY=

# Poczta. Bez tych zmiennych wiadomości trafiają na konsolę serwera.
# Na serwerze sklepu odkomentuj i uzupełnij danymi skrzynki sklepu (SMTP z TLS na porcie 587).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Warzywniak <sklep@example.com>
